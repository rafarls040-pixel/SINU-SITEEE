rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidArticle(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 500
        && data.content is string && data.content.size() > 0 && data.content.size() <= 100000
        && data.publisher is string && data.publisher.size() <= 100
        && data.category is string && data.category.size() <= 100
        && (!('subtitle' in data) || data.subtitle is string)
        && (!('committee' in data) || data.committee is string)
        && (!('author' in data) || data.author is string)
        && (!('imageUrl' in data) || data.imageUrl is string)
        && (!('isPinned' in data) || data.isPinned is bool)
        && (!('tags' in data) || data.tags is list);
    }

    match /articles/{articleId} {
      allow read: if true;
      allow create: if isValidId(articleId) && isValidArticle(incoming());
      allow update: if isValidId(articleId) && isValidArticle(incoming());
      allow delete: if isValidId(articleId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
